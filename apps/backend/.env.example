# Server
NODE_ENV=development
PORT=5050
# Public origin of the web app, not the API. Verification, password reset and newsletter
# links are all built from it.
APP_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=orgatick

# Redis
# Either provide a connection URL (recommended for hosted Redis like Upstash, Redis Cloud, etc.):
# REDIS_URL=rediss://default:password@host.upstash.io:6379
# Or configure host, port, credentials, and TLS individually:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
# Only needed when Redis requires authentication.
REDIS_PASSWORD=
# Point the mail queue at its own database to keep its keys away from the cache.
REDIS_DB=0
# Optional explicit TLS toggle (auto-enabled for rediss:// or *.upstash.io)
REDIS_TLS=false

# Cache
ORGANIZATION_MEMBERSHIP_CACHE_TTL_MS=300000

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Newsletter
# Master switch for subscriptions, dispatch scheduling and lifecycle emails.
NEWSLETTER_ENABLED=true
# Everything below has a working default in code, so nothing here is required. Override only when a
# deployment needs different behaviour:
#   Double opt-in, tracking, sender identity, confirmation TTL, tick interval and the per-send
#   recipient ceiling are read from env.validation.ts with the defaults used here.
#   NEWSLETTER_TOKEN_SECRET     - token signing key, falls back to JWT_SECRET. Min 32 chars.
#   NEWSLETTER_WEBHOOK_SECRET   - verifies deliverability webhook signatures (t=...,v1=...).
#                                 While unset the endpoint accepts unsigned events.

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Resend (transactional email)
RESEND_API_KEY=

# Cloudflare R2 (object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=

# GitHub Packages (reading private @orgatick/* packages)
GITHUB_TOKEN=

# Observe (observability)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
