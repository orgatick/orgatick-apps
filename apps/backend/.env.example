# Server
NODE_ENV=development
PORT=5050
# Public origin of the web app, not the API. Verification, password reset and newsletter
# links are all built from it.
APP_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=orgatick

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Cache
ORGANIZATION_MEMBERSHIP_CACHE_TTL_MS=300000

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Newsletter
# Master switch for subscriptions, dispatch scheduling and lifecycle emails.
NEWSLETTER_ENABLED=true
# When true, a new subscriber must click the confirmation link before any campaign is sent to them.
NEWSLETTER_DOUBLE_OPT_IN=true
# Open/click tracking. Disable if the campaign content must stay pixel free.
NEWSLETTER_TRACKING_ENABLED=true
NEWSLETTER_FROM_NAME=Orgatick Newsletter
NEWSLETTER_FROM_EMAIL=newsletter@orgatick.in
NEWSLETTER_REPLY_TO=support@orgatick.in
# Only set this when the newsletter pages live on a different host than the app.
# Leave it empty to build every email link from APP_URL.
NEWSLETTER_PUBLIC_BASE_URL=
# Signs confirm/unsubscribe/preferences tokens. Falls back to JWT_SECRET when empty. Min 32 chars.
NEWSLETTER_TOKEN_SECRET=
NEWSLETTER_CONFIRMATION_TTL_MINUTES=2880
# Scheduler tick. Replicas contend on a Redis lock, so only one dispatches per tick.
NEWSLETTER_DISPATCH_INTERVAL_MS=15000
NEWSLETTER_BATCH_SIZE=100
# Hard ceiling on recipients for a single campaign send.
NEWSLETTER_MAX_RECIPIENTS_PER_SEND=100000
# Shared secret used to verify deliverability webhook signatures (t=...,v1=...).
NEWSLETTER_WEBHOOK_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Resend (transactional email)
RESEND_API_KEY=

# Cloudflare R2 (object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=

# GitHub Packages (reading private @orgatick/* packages)
GITHUB_TOKEN=

# Observe (observability)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
