# Server
NODE_ENV=development
PORT=5050
APP_URL=http://localhost:5050
COOKIE_DOMAIN=localhost

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_NAME=orgatick

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Cache
ORGANIZATION_MEMBERSHIP_CACHE_TTL_MS=300000

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# Resend (transactional email)
RESEND_API_KEY=

# Cloudflare R2 (object storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=

# GitHub Packages (reading private @orgatick/* packages)
GITHUB_TOKEN=

# Observe (observability)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
