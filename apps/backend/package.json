{
  "name": "@orgatick/backend",
  "version": "0.0.1",
  "description": "",
  "author": "Abhishek Kumar",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --no-shell",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check-types": "tsc -p tsconfig.build.json --noEmit",
    "check": "biome check .",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate dist/database/migrations/Init -d dist/data-source.js",
    "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migration:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d dist/data-source.js",
    "seed": "ts-node -r tsconfig-paths/register dist/database/seeder/run.js",
    "chartdb": "docker compose -f tools/chartdb/docker-compose.yml up -d",
    "chartdb:down": "docker compose -f tools/chartdb/docker-compose.yml down",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@keyv/redis": "^5.1.6",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/observe": "^0.1.8",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/typeorm": "^12.0.2",
    "@orgatick/contracts": "workspace:*",
    "@orgatick/email-templates": "workspace:*",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "cache-manager": "^7.2.9",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ioredis": "^6.0.0",
    "keyv": "^5.6.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.26.0",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.1",
    "typeorm-extension": "^4.1.0",
    "typeorm-naming-strategies": "^4.1.0",
    "typeorm-transactional": "^0.5.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
