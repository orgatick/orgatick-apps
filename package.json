{
  "name": "orgatick",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "clean": "turbo run clean && rm -rf node_modules",
    "infra": "docker compose -f infrastructure/docker-compose.yml up -d"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "turbo": "^2.11.10",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.12.1"
  }
}
