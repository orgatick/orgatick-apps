{
  "name": "@orgatick/email-templates",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check --write .",
    "check-types": "tsc --noEmit",
    "dev": "email dev --port 4000",
    "export": "email export --out-dir out --pretty",
    "format": "biome format --write .",
    "lint": "biome check .",
    "preview:build": "email build"
  },
  "dependencies": {
    "@react-email/render": "^2.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-email": "6.9.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@react-email/ui": "6.9.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.2"
  },
  "main": "./dist/emails/index.js",
  "types": "./dist/emails/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/emails/index.d.ts",
      "default": "./dist/emails/index.js"
    }
  }
}
