{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "jsx": "react-jsx",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "isolatedModules": false,
    "lib": ["ES2023", "DOM"]
  },
  "include": ["emails/**/*.ts", "emails/**/*.tsx"],
  "exclude": ["node_modules", ".react-email", "dist"]
}
