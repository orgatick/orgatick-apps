// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["cn", "cva", "cx", "clsx", "twMerge"],
        "experimental": {
          "configFile": {
            "apps/client/app/globals.css": "apps/client/**",
            "apps/organizer/app/globals.css": "apps/organizer/**",
            "apps/admin/app/globals.css": "apps/admin/**",
            "packages/ui/src/styles/globals.css": "packages/**"
          }
        }
      }
    }
  },
  "formatter": {
    "language_server": {
      "name": "biome"
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
    "TypeScript": {
      "language_servers": ["biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
    "TSX": {
      "language_servers": ["biome", "tailwindcss-language-server", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true
      }
    },
    "JSON": {
      "language_servers": ["biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    },
    "JSONC": {
      "language_servers": ["biome", "..."],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      }
    }
  }
}